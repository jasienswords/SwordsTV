rules_version = '2';
// Queuey security rules. Paste into Firebase console → Firestore Database → Rules → Publish.
// Replace FAMILY_EMAILS below with the original family's two Google addresses (lowercase).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function householdData(h) { return get(/databases/$(database)/documents/households/$(h)).data; }
    function isMember(h) { return signedIn() && request.auth.uid in householdData(h).memberUids; }

    // Which household an account belongs to: only that account.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /households/{h} {
      // Start a household with yourself as its only member and owner.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      // Members can change anything except who owns it. Someone invited by email
      // (a confirmed address) may add only themselves.
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.memberUids
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.auth.uid in request.resource.data.memberUids)
        || (verified() && email() in resource.data.invitedEmails
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'invitedEmails'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Each person's ratings: the household's members only.
      match /profiles/{p} {
        allow read, write: if isMember(h);
      }
    }

    // Invitations, keyed by the invited email address.
    match /invites/{em} {
      allow read, delete: if (verified() && email() == em) || (resource != null && isMember(resource.data.householdId));
      allow create, update: if isMember(request.resource.data.householdId);
    }

    // Anonymous ratings (no names or emails) for the nightly job that finds new shows.
    match /signals/{h} {
      allow read: if true;
      allow write: if isMember(h);
    }

    // The first version's shared family document: the original family only.
    match /families/{f} {
      allow read, write: if verified() && email() in FAMILY_EMAILS;
    }
  }
}
